---
interface Props {
  title: string;
  description?: string;
  image?: string;
  passwordProtected?: boolean;
  isSplash?: boolean;
}

const {
  title,
  description = 'Portfolio of Charlie Herbozo-Vidal, Senior Design Manager & Product Strategist based in New York, NY. Leading enterprise product design, AI-led prototyping systems, design systems engineering, and omnichannel UX architecture.',
  image = '/images/og-cover.png',
  passwordProtected = false,
  isSplash = false,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const siteUrl = 'https://www.charliehv.design';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;

const featuredProjects = [
  { name: 'AI-Led Prototyping', href: '/projects/ai-prototyping' },
  { name: 'Point of Sale', href: '/projects/point-of-sale' },
  { name: 'Loyalty & Strategy', href: '/projects/loyalty-and-strategy' },
  { name: 'Specialty Pharmacy & AI', href: '/projects/specialty-pharmacy' },
  { name: 'Design Systems', href: '/projects/design-systems' },
  { name: 'UX@CVS Conference', href: '/projects/ux-conference' },
  { name: 'Creative Direction', href: '/projects/creative-direction' },
];

const craftProjects = [
  { name: 'Furniture Design', href: '/projects/furniture-design' },
  { name: 'Photography work', href: '/projects/photography' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Charlie Herbozo-Vidal, Senior Design Manager NYC, Product Design Manager New York, UX Director NYC, AI Design Leadership, Enterprise Design Systems Lead, Omnichannel UX Strategy, Design Technologist New York City" />
    <meta name="author" content="Charlie Herbozo-Vidal" />
    <meta name="geo.region" content="US-NY" />
    <meta name="geo.placename" content="New York" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:site_name" content="Charlie Herbozo-Vidal" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data for Local SEO & Recruiter Discovery -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://www.charliehv.design/#person",
          "name": "Charlie Herbozo-Vidal",
          "jobTitle": "Senior Design Manager & Product Strategist",
          "url": "https://www.charliehv.design",
          "image": "https://www.charliehv.design/images/headshot.jpg",
          "sameAs": [
            "http://www.linkedin.com/in/charlie-herbozovidal"
          ],
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "New York",
            "addressRegion": "NY",
            "addressCountry": "US"
          },
          "knowsAbout": [
            "Design Management",
            "Product Design",
            "UX Strategy & Research",
            "AI-Led Prototyping Systems",
            "Enterprise Design Systems",
            "Omnichannel Commerce & POS Modernization",
            "Healthcare Digital Strategy",
            "Interaction Design",
            "Cross-Functional Design Leadership"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://www.charliehv.design/#website",
          "url": "https://www.charliehv.design",
          "name": "Charlie Herbozo-Vidal | Senior Design Manager & Product Strategist",
          "description": "Portfolio of Charlie Herbozo-Vidal, Senior Design Manager & Product Strategist based in New York, NY specializing in AI-led prototyping, enterprise design systems, and omnichannel product strategy.",
          "publisher": {
            "@id": "https://www.charliehv.design/#person"
          }
        }
      ]
    })} />
    {passwordProtected && (
      <script is:inline>
        (function () {
          try {
            const HASH = '8a0c3f6e';
            const KEY = 'chv_auth';
            const hasLocal = localStorage.getItem(KEY) === HASH;
            const hasCookie = document.cookie.indexOf(KEY + '=' + HASH) !== -1;
            if (hasLocal || hasCookie) {
              document.documentElement.classList.add('authenticated');
              if (!hasLocal) localStorage.setItem(KEY, HASH);
              if (!hasCookie) document.cookie = KEY + '=' + HASH + '; path=/; max-age=31536000; SameSite=Lax';
            }
          } catch (e) {}
        })();
      </script>
    )}
  </head>
  <body>
    {passwordProtected && (
      <div class="password-gate-overlay" id="passwordGate">
        <form class="password-pill-container" id="passwordForm">
          <input
            type="password"
            class="password-pill-input"
            id="passwordInput"
            placeholder="Enter password..."
            autocomplete="off"
            autofocus
          />
          <button type="submit" class="password-pill-btn" id="passwordSubmitBtn">Submit</button>
        </form>
        <div class="password-error-msg" id="passwordError"></div>
        <a href="/" class="password-back-link">← Back to Work</a>
      </div>
    )}

    {isSplash ? (
      <slot />
    ) : (
      <div class="site-shell">
        <!-- Modern Global Top Header (Auto-hidden on initial home view, glides in on scroll; persistent on all subpages) -->
        <header class={`site-header ${currentPath === '/' ? 'header-on-home' : ''}`} id="globalSiteHeader">
          <div class="header-inner">
            <a href="/" class="header-brand">
              <span class="brand-name">Charlie Herbozo-Vidal</span>
              <span class="brand-title">Principal Product Designer &amp; Systems Strategist</span>
            </a>
            <nav class="header-nav">
              <a href="/" class={`header-link ${currentPath === '/' ? 'active' : ''}`}>Work</a>
              <a href="/about" class={`header-link ${currentPath === '/about' ? 'active' : ''}`}>About</a>
              <a href="/contact" class={`header-link ${currentPath === '/contact' ? 'active' : ''}`}>Contact</a>
              <a href="http://www.linkedin.com/in/charlie-herbozovidal" target="_blank" rel="noopener" class="header-btn-linkedin" aria-label="LinkedIn Profile">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.53 1.53 0 0 0 0-3.06 1.53 1.53 0 0 0 0 3.06m1.4 9.74V10.13H5.06v8.37z"/>
                </svg>
                <span>LinkedIn</span>
              </a>
            </nav>
          </div>
        </header>

        <main class="main-content">
          <slot />
        </main>
      </div>
    )}

    {passwordProtected && (
      <script is:inline>
        (function () {
          const PASS_HASH = '8a0c3f6e';
          const STORAGE_KEY = 'chv_auth';

          const gate = document.getElementById('passwordGate');
          const form = document.getElementById('passwordForm');
          const input = document.getElementById('passwordInput');
          const error = document.getElementById('passwordError');
          const btn = document.getElementById('passwordSubmitBtn');

          const hasAuth =
            localStorage.getItem(STORAGE_KEY) === PASS_HASH ||
            document.cookie.indexOf(STORAGE_KEY + '=' + PASS_HASH) !== -1;

          if (hasAuth) {
            document.documentElement.classList.add('authenticated');
            gate.classList.add('hidden');
          }

          if (input && btn) {
            input.addEventListener('input', function () {
              if (input.value.length > 0) {
                btn.style.background = '#222222';
              } else {
                btn.style.background = '#d6d6d6';
              }
            });
          }

          if (form) {
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              const entered = input.value.trim();
              if (entered === 'CharlieHV') {
                try {
                  localStorage.setItem(STORAGE_KEY, PASS_HASH);
                  document.cookie =
                    STORAGE_KEY +
                    '=' +
                    PASS_HASH +
                    '; path=/; max-age=31536000; SameSite=Lax';
                } catch (err) {}
                document.documentElement.classList.add('authenticated');
                gate.classList.add('hidden');
              } else {
                error.textContent = 'Incorrect password. Please try again.';
                input.value = '';
                input.focus();
                if (btn) btn.style.background = '#d6d6d6';
              }
            });
          }
        })();
      </script>
    )}

    <script is:inline>
      const header = document.getElementById('globalSiteHeader');
      if (header && header.classList.contains('header-on-home')) {
        const handleScroll = () => {
          if (window.scrollY > 200) {
            header.classList.add('is-scrolled');
          } else {
            header.classList.remove('is-scrolled');
          }
        };
        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll();
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
