---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects, craftProjects } from '../content/projects';
---

<BaseLayout
  title="Charlie Herbozo-Vidal | Senior Design Manager & Product Strategist (NYC)"
  description="Charlie Herbozo-Vidal is a New York City-based Senior Design Manager & Product Strategist leading enterprise product teams, AI-driven prototyping systems, scalable design systems, and omnichannel UX architecture."
  image="/images/og-cover.png"
  passwordProtected={false}
>
  <!-- Executive Work Header -->
  <header class="work-hero-header">
    <div class="hero-graphic-section">
      <img
        src="/images/splash-illustration.png"
        alt="Charlie Herbozo-Vidal Design Process Wireframe"
        class="hero-graphic-img"
      />
    </div>

    <div class="hero-intro-section">
      <h1 class="hero-name">Charlie Herbozo-Vidal</h1>

      <p class="hero-subtitle">
        Senior Design Manager &amp; Product Strategist
      </p>

      <p class="hero-summary">
        Guiding high-impact design teams and architecting omnichannel product ecosystems at enterprise scale. Grounded in systems engineering, behavioral research, and measurable business growth.
      </p>

      <div class="hero-actions-row">
        <a href="/about" class="btn-hero-philosophy">
          Leadership Philosophy &rarr;
        </a>

        <div class="hero-social-row">
          <!-- LinkedIn -->
          <a
            href="http://www.linkedin.com/in/charlie-herbozovidal"
            target="_blank"
            rel="noopener"
            class="social-icon-btn"
            aria-label="LinkedIn Profile"
            title="LinkedIn Profile"
          >
            <svg viewBox="0 0 30 24">
              <path d="M19.6,19v-5.8c0-1.4-0.5-2.4-1.7-2.4c-1,0-1.5,0.7-1.8,1.3C16,12.3,16,12.6,16,13v6h-3.4 c0,0,0.1-9.8,0-10.8H16v1.5c0,0,0,0,0,0h0v0C16.4,9,17.2,7.9,19,7.9c2.3,0,4,1.5,4,4.9V19H19.6z M8.9,6.7L8.9,6.7 C7.7,6.7,7,5.9,7,4.9C7,3.8,7.8,3,8.9,3s1.9,0.8,1.9,1.9C10.9,5.9,10.1,6.7,8.9,6.7z M10.6,19H7.2V8.2h3.4V19z"></path>
            </svg>
          </a>

          <!-- Email -->
          <a
            href="mailto:charlie@charliehv.design"
            class="social-icon-btn"
            aria-label="Email Charlie"
            title="Contact by Email"
          >
            <svg viewBox="0 0 30 24">
              <path d="M15,13L7.1,7.1c0-0.5,0.4-1,1-1h13.8c0.5,0,1,0.4,1,1L15,13z M15,14.8l7.9-5.9v8.1c0,0.5-0.4,1-1,1H8.1c-0.5,0-1-0.4-1-1 V8.8L15,14.8z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Executive Impact Ticker -->
  <section class="metrics-ticker-section">
    <div class="metrics-container">
      <div class="metric-card">
        <span class="metric-val">80M+</span>
        <span class="metric-desc">Active Members in Ecosystem</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">$60M</span>
        <span class="metric-desc">Incremental YoY Margin (Loyalty)</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">$300M+</span>
        <span class="metric-desc">Operational Savings (POS Modernization)</span>
      </div>
      <div class="metric-card">
        <span class="metric-val">9,000+</span>
        <span class="metric-desc">Retail Stores Transformed</span>
      </div>
    </div>
  </section>

  <!-- Projects Grid Container -->
  <div class="home-work-container">
    <!-- Section: Strategic Leadership Case Studies -->
    <div class="section-header-block">
      <div class="section-eyebrow">Enterprise Systems &amp; Strategy</div>
      <h2 class="section-heading">Strategic Leadership Case Studies</h2>
      <p class="section-subtext">
        Omnichannel transformations, complex healthcare workflows, design systems architecture, and nationwide retail rollouts.
      </p>
    </div>

    <div class="leadership-projects-grid">
      {featuredProjects.map((project) => (
        <a href={`/projects/${project.slug}`} class="leadership-card">
          <div class="card-image-wrap">
            <img src={project.coverImage} alt={project.title} loading="lazy" />
            <div class="card-hover-indicator">
              <span>View Case Study &rarr;</span>
            </div>
          </div>
          <div class="card-content">
            <div class="card-category-row">
              <span class="card-category">{project.category}</span>
              {project.impactMetric && (
                <span class="card-impact-pill">{project.impactMetric}</span>
              )}
            </div>
            <h3 class="card-title">{project.title}</h3>
            {project.subtitle && <p class="card-subtitle">{project.subtitle}</p>}
            <p class="card-description">{project.description}</p>
            <div class="card-footer-meta">
              <span class="card-role-label"><strong>Leadership Role:</strong> {project.role}</span>
              <span class="card-arrow">&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Section: Industrial Design & Photography -->
    <div class="section-header-block section-craft-spacing">
      <div class="section-eyebrow">Physical Craft &amp; Space</div>
      <h2 class="section-heading">Industrial Design &amp; Photography</h2>
      <p class="section-subtext">
        Grounding digital systems in physical space: explorations in solid wood joinery, functional objects, and environmental photography.
      </p>
    </div>

    <div class="craft-projects-grid">
      {craftProjects.map((project) => (
        <a href={`/projects/${project.slug}`} class="craft-card">
          <div class="craft-image-wrap">
            <img src={project.coverImage} alt={project.title} loading="lazy" />
            <div class="craft-overlay">
              <div class="craft-title">{project.title}</div>
              <div class="craft-category">{project.category}</div>
            </div>
          </div>
          <div class="craft-caption">
            <h4>{project.title}</h4>
            <p>{project.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
